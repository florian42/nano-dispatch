{
  "name": "nano-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome side-panel extension that dispatches page context to a Telegram bot.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "fmt": "prettier --write .",
    "verify": "npm run typecheck && npm run lint && npm test",
    "verify:sw-init": "npm run build && node scripts/load-sw.mjs",
    "auth:send-code": "node --env-file=.env --import tsx scripts/auth.ts send-code",
    "auth:complete": "node --env-file=.env --import tsx scripts/auth.ts complete",
    "probe:send": "node --env-file=.env --import tsx scripts/probe-send.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.22.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "input": "^1.0.1",
    "telegram": "^2.26.22"
  }
}
