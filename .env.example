# nano-dispatch — Telegram MTProto credentials
#
# Register an app at https://my.telegram.org/apps to get api_id and api_hash.
# These are not secrets in the cryptographic sense (Telegram ties them to your
# account, not a server), but they identify your app to Telegram and should
# not be shared.
#
# These values are pasted into the extension's Options page at runtime; this
# file is only a local stash so you don't lose them between rebuilds.

TG_API_ID=
TG_API_HASH=

# Recipient: bot username (with or without leading @) or numeric ID.
# For nano-dispatch this is the nanoclaw bot.
TG_PEER=@nanoclaw

# Phone number in international format (e.g. +14155552671). Used during the
# one-time sign-in flow on the Options page.
TG_PHONE=

# Filled in by the extension after successful sign-in. Stored in
# chrome.storage.local at runtime; copy here only if you want a backup.
# This is the credential — anyone who has it can read your DMs and post
# as you. Never commit, never share.
TG_SESSION=
